    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/chadsimon/.claude/hooks/worktree_create.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/chadsimon/.claude/hooks/worktree_remove.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/chadsimon/.claude/bin/hook_chain.py --chain post-failure",
            "timeout": 8
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/chadsimon/.claude/bin/subagent_verify.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 /Users/chadsimon/.claude/bin/stop_reason_telemetry.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/chadsimon/.claude/bin/session_end_summary.py",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "bash /Users/chadsimon/.claude/bin/notify_done.sh --status success --task session-end --channel desktop",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/chadsimon/.claude/bin/omni_mem_health_probe.sh",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "python3 /Users/chadsimon/.claude/bin/omni_mem_session_start.py",
            "timeout": 8
          },
          {
            "type": "command",
            "command": "python3 /Users/chadsimon/.claude/bin/rlm_session_preflight.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 /Users/chadsimon/.claude/bin/omni_mem_inbox_session_start.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/chadsimon/.claude/bin/permission_denied_retry.py",
            "timeout": 3
          }
        ]
      }
