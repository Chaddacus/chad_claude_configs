    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/chadsimon/.claude/bin/instructions_loaded_log.py",
            "timeout": 3
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "user_settings",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/chadsimon/.claude/bin/config_change_log.py",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "project_settings",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/chadsimon/.claude/bin/config_change_log.py",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "local_settings",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/chadsimon/.claude/bin/config_change_log.py",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "policy_settings",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/chadsimon/.claude/bin/config_change_log.py",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "skills",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/chadsimon/.claude/bin/config_change_log.py",
            "timeout": 3
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": "settings.json",
        "hooks": [
          {
            "type": "command",
            "command": "jq -c '{ts: (now|todate), kind: \"file_changed\", source: \"filesystem\", file_path: (.file_path // .filename // \"unknown\"), event: \"FileChanged\"}' >> /Users/chadsimon/.claude/state/config-drift.jsonl 2>/dev/null || exit 0",
            "timeout": 3
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -c '{ts: (now|todate), kind: \"cwd_changed\", from: (.previous_cwd // .from_cwd // null), to: (.cwd // .new_cwd // .to_cwd // \"unknown\")}' >> /Users/chadsimon/.claude/state/cwd-log.jsonl 2>/dev/null || exit 0",
            "timeout": 3
          }
        ]
      }
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      "node_modules",
      ".cache",
      ".pnpm-store"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline"
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "second-opinion@trailofbits": true,
    "static-analysis@trailofbits": false,
    "insecure-defaults@trailofbits": true,
    "sharp-edges@trailofbits": true,
    "frontend-design@claude-plugins-official": true
  },
  "feedbackSurveyRate": 0,
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "agent": "chad-twin",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoCompactEnabled": true,
  "mcpServers": {},
  "model": "claude-fable-5[1m]"
}
