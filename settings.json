{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "POLICY_EDIT_GATE_ASYNC": "1",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "400000",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://127.0.0.1:4317",
    "OTEL_EXPORTER_OTLP_INSECURE": "true",
    "OTEL_LOG_USER_PROMPTS": "0",
    "OTEL_RESOURCE_ATTRIBUTES": "deployment.environment=local,collector.name=logging_and_metrics,agent.family=claude"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Write",
      "Read",
      "Grep",
      "Glob",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Task",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskUpdate",
      "TaskStop",
      "TaskOutput",
      "Monitor",
      "NotebookEdit",
      "Skill",
      "ScheduleWakeup",
      "ToolSearch",
      "mcp__omni-mem__save_memory",
      "mcp__omni-mem__save_preference",
      "mcp__omni-mem__journal_write",
      "mcp__omni-mem__fact_add",
      "mcp__omni-mem__fact_query",
      "mcp__omni-mem__fact_invalidate",
      "mcp__omni-mem__fact_stats",
      "mcp__omni-mem__fact_timeline",
      "mcp__omni-mem__search",
      "mcp__omni-mem__build_context",
      "mcp__omni-mem__build_briefing",
      "mcp__omni-mem__build_memory_pack",
      "mcp__omni-mem__consolidate_memory",
      "mcp__omni-mem__check_duplicate",
      "mcp__omni-mem__journal_read",
      "mcp__omni-mem__list_domains",
      "mcp__omni-mem__list_topics",
      "mcp__omni-mem__timeline",
      "mcp__omni-mem__topic_graph",
      "mcp__omni-mem__taxonomy_overview",
      "mcp__omni-mem__provider_metrics"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME)",
      "Bash(git push --force origin main)",
      "Bash(git push --force origin master)",
      "Bash(git push -f origin main)",
      "Bash(git push -f origin master)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/credentials)",
      "Read(**/credentials.json)",
      "Read(~/.ssh/id_*)",
      "Read(~/.ssh/*_rsa)",
      "Read(~/.ssh/*_ed25519)",
      "Read(~/.aws/credentials)",
      "Read(~/.aws/config)",
      "Bash(cat .env*)",
      "Bash(cat ~/.ssh/id_*)",
      "Bash(cat ~/.aws/credentials)",
      "Read(~/.claude.json)",
      "Read(~/.claude/kickstarter-tokens.json)",
      "Read(~/.kube/config)",
      "Read(~/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.config/op/**)",
      "Bash(cat ~/.claude.json)",
      "Bash(cat ~/.claude/kickstarter-tokens.json)"
    ],
    "ask": [
      "mcp__ks-rapture-gateway"
    ],
    "defaultMode": "auto"
  },
  "fallbackModel": [
    "sonnet"
  ],
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/chadsimon/code/omni-mem/hooks/omni_mem_save_hook.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 /Users/chadsimon/.claude/bin/hook_chain.py --chain stop",
            "timeout": 90
          },
          {
            "type": "command",
            "command": "python3 /Users/chadsimon/.claude/dandori/bin/hook_shadow_stop.py",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/chadsimon/.claude/bin/stop_failure_alert.py",
            "timeout": 10
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/chadsimon/.claude/bin/completion_gate.py --event task-completed",
            "timeout": 60
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/chadsimon/code/omni-mem/hooks/omni_mem_precompact_hook.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 /Users/chadsimon/.claude/bin/precompact_track_marker.py",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/chadsimon/.claude/bin/idle_timing_hook.py",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "python3 /Users/chadsimon/.claude/skills/govern/scripts/classify_prompt.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 /Users/chadsimon/.claude/bin/case_rotator.py",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/chadsimon/.claude/bin/pre_tool_guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/chadsimon/.claude/bin/policy_edit_gate.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/chadsimon/.claude/bin/hook_chain.py --chain post-edit",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 /Users/chadsimon/.claude/dandori/bin/hook_record_edit.py",
