# Allowlist-style .gitignore for ~/.claude config
# Default: ignore EVERYTHING. Selectively unignore tracked items below.
# This bias prevents accidental secret/state commits.

/*

# Repo metadata
!/.gitignore
!/README.md

# Canonical policy docs
!/CLAUDE.md
!/POLICY_OWNERSHIP.md

# Runtime config (NOT settings.local.json — machine-specific)
!/settings.json

# Behavior surfaces (tracked fully)
!/agents/
!/commands/
!/skills/
!/standards/
!/sounds/
!/mcp-servers/
!/tests/
!/rules/
# rules/legacy-reference is local-only; the rest of rules/ is tracked
/rules/legacy-reference/

# Custom scripts
!/bin/
# Exclude bin compiled/cache artifacts
/bin/__pycache__/
/bin/.pytest_cache/

# State directory — only specific governed-config files
!/state/
/state/*
!/state/route_manifest.json
!/state/control_plane.json

# Plugins — only the blocklist; NOT installed_plugins.json: the harness
# continuously restamps the frontend-design entry with this repo's HEAD
# (machine-managed cache metadata), so tracking it meant a permanently
# dirty file churning on every commit (2026-07-16 audit I14; untracked
# via `git rm --cached`, file stays on disk for the harness).
!/plugins/
/plugins/*
!/plugins/blocklist.json

# Policy — versioned policy/registry artifacts (pre-registered hypotheses,
# phase question registry, etc.). Tracked fully because changes here are
# binding architectural decisions.
!/policy/

# Bench — validation tooling (analyze.py) + immutable baseline corpus for
# Layer-3 outcome validation per plan-final §7. Tracked fully.
!/bench/

# Dandori — streaming-gate experiment. Its hooks are registered in
# settings.json, so the code must be versioned. State stays in /state.
!/dandori/
/dandori/.claude/

# Plans — local-only by default; named plans that are decision records for
# committed changes are unignored individually.
!/plans/
/plans/*
!/plans/global-config-improvement-plan-2026-06-09.md

# ====================================================================
# Paranoid denies (catch anything sneaked into tracked dirs)
# ====================================================================
**/auth.json
**/.auth*
**/*.token
**/*.pem
**/*.key
**/*.secret
**/secrets/
**/.env
**/.env.*
**/credentials.json
**/credentials*.json
**/*credentials*
**/api_keys*
**/.ssh/
**/*.sqlite
**/*.sqlite3
**/*.db
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
**/node_modules/
**/.DS_Store
**/*.swp
**/*.bak
**/*.log
