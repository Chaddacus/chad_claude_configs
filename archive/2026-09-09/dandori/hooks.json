{
  "version": "dandori-hooks.v1",
  "note": "Classification overlay for the live settings.json hooks. setup=internal means the user/turn is blocked while it runs (uchi-dandori); external means it can run off the critical path (soto-dandori). convertible=true marks internal work that COULD be moved external (the SMED worklist). Matched against live settings.json by command substring; hooks_audit.py fails on any live hook missing a classification.",
  "classification": [
    {"key": "omni_mem_save_hook.sh", "setup": "external", "convertible": true, "note": "memory save can run in background during the turn"},
    {"key": "product_truth_auto_dispatch.py", "setup": "external", "convertible": true, "note": "inbox dispatch is off the user's critical path"},
    {"key": "completion_gate.py", "setup": "internal", "convertible": true, "note": "PRIME TARGET: stream verification during execution (POC proven)"},
    {"key": "replan_evidence_check.py", "setup": "internal", "convertible": true, "note": "evidence check could stream during the turn"},
    {"key": "stop_gate.py", "setup": "internal", "convertible": false, "note": "lexical stop guard must decide synchronously — irreducible"},
    {"key": "stop_reason_telemetry.py", "setup": "external", "convertible": false, "note": "telemetry, non-blocking"},
    {"key": "self_merge_check.py", "setup": "external", "convertible": false, "note": "advisory warn, does not gate the stop"},
    {"key": "idle_timing_hook.py", "setup": "internal", "convertible": false, "note": "augments the prompt; cheap (3s)"},
    {"key": "classify_prompt.py", "setup": "internal", "convertible": true, "note": "PRIME TARGET: pre-classify speculatively while the user types"},
    {"key": "case_rotator.py", "setup": "external", "convertible": false, "note": "test-case bookkeeping"},
    {"key": "pre_tool_guard.py", "setup": "internal", "convertible": false, "note": "destructive-command guard must gate synchronously"},
    {"key": "policy_edit_gate.py", "setup": "internal", "convertible": false, "note": "must gate before the edit applies"},
    {"key": "edit_verify_async.py", "setup": "external", "convertible": false, "note": "already async; the streaming-gate feeder"},
    {"key": "agent_def_edit_warn.py", "setup": "external", "convertible": false, "note": "advisory warn"},
    {"key": "case_recorder.py", "setup": "external", "convertible": false, "note": "behavioral recording"},
    {"key": "compaction_suggester.py", "setup": "external", "convertible": false, "note": "advisory"},
    {"key": "omni_mem_precompact_hook.sh", "setup": "external", "convertible": false, "note": "compaction maintenance"},
    {"key": "worktree_create.sh", "setup": "external", "convertible": false, "note": "worktree lifecycle"},
    {"key": "worktree_remove.sh", "setup": "external", "convertible": false, "note": "worktree lifecycle"},
    {"key": "tool_failure_context.py", "setup": "external", "convertible": false, "note": "failure recovery context"},
    {"key": "post_tool_use_failure_fal.py", "setup": "external", "convertible": false, "note": "failure analysis logging"},
    {"key": "subagent_verify.py", "setup": "external", "convertible": false, "note": "subagent telemetry"},
    {"key": "session_end_summary.py", "setup": "external", "convertible": false, "note": "session-end persistence"},
    {"key": "notify_done.sh", "setup": "external", "convertible": false, "note": "notification"},
    {"key": "omni_mem_health_probe.sh", "setup": "external", "convertible": false, "note": "session-start staging (soto-dandori)"},
    {"key": "omni_mem_session_start.py", "setup": "external", "convertible": false, "note": "session-start briefing prefetch (soto-dandori)"},
    {"key": "rlm_session_preflight.py", "setup": "external", "convertible": false, "note": "codebase index prewarm (soto-dandori)"},
    {"key": "omni_mem_inbox_session_start.py", "setup": "external", "convertible": false, "note": "inbox prefetch (soto-dandori)"},
    {"key": "permission_denied_retry.py", "setup": "external", "convertible": false, "note": "recovery suggestion"},
    {"key": "instructions_loaded_log.py", "setup": "external", "convertible": false, "note": "audit log"},
    {"key": "config_change_log.py", "setup": "external", "convertible": false, "note": "audit log"},
    {"key": "hook_record_edit.py", "setup": "external", "convertible": false, "note": "streaming-gate feeder: launches background verify on edit (the converted external setup)"},
    {"key": "hook_shadow_stop.py", "setup": "external", "convertible": false, "note": "shadow-mode streamed-vs-real logger; non-blocking, non-authoritative"},
    {"key": "config-drift.jsonl", "setup": "external", "convertible": false, "note": "file-change audit log"},
    {"key": "cwd-log.jsonl", "setup": "external", "convertible": false, "note": "cwd-change audit log"}
  ]
}
